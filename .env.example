# Application database used by npm start, npm run migrate, and npm run seed.
# Replace both placeholders with credentials for your local PostgreSQL role.
DATABASE_URL=postgresql://YOUR_LOCAL_USER:YOUR_LOCAL_PASSWORD@localhost:5432/ledgerline_dev

# Tests and mutation checks use only this separate, disposable local database.
# Replace both placeholders with your local PostgreSQL credentials. Never use
# Neon, production, or any other remote database for TEST_DATABASE_URL.
TEST_DATABASE_URL=postgresql://YOUR_LOCAL_USER:YOUR_LOCAL_PASSWORD@localhost:5432/ledgerline_test

# Replace this placeholder with a long, private random value.
JWT_SECRET=change-me-to-a-long-random-string
# Optional one-time admin bootstrap secret: replace with a random value of at least 32 characters.
BOOTSTRAP_SECRET=replace-with-a-random-secret-at-least-32-characters
PORT=3000
