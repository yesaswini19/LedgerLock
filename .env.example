# Application connection used by npm start, npm run migrate, and npm run seed.
# This local development example is separate from the disposable test database.
DATABASE_URL=postgresql://ledgerline_user:replace_me@localhost:5432/ledgerline_dev

# Tests and mutation checks require a disposable local PostgreSQL database.
# Never set this to Neon or another remote database.
TEST_DATABASE_URL=postgresql://ledgerline_user:replace_me@localhost:5432/ledgerline_test

# Replace this placeholder with a long, private random value.
JWT_SECRET=change-me-to-a-long-random-string
PORT=3000
